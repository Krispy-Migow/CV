# Lista blanca: se ignora TODO y solo se respalda lo que está aquí.
# Un archivo nuevo queda fuera hasta que lo agregues con una regla "!".
*

# Configuración del proyecto
!.gitignore
!.python-version
!README.md
!pyproject.toml
!uv.lock

# Código fuente y pruebas
!src/
!src/**
!tests/
!tests/**

# Configuración del entrenamiento
!configs/
!configs/config.yaml

# Notebook tutorial
!notebooks/
!notebooks/*.ipynb

# Página web estática (usa app/model y app/assets; se publica en Netlify)
!netlify.toml
!web/
!web/index.html

# App de Streamlit: modelo, métricas y dependencias para el despliegue
!app/
!app/streamlit_app.py
!app/requirements.txt
!app/model/
!app/model/best.onnx
!app/model/classes.json
!app/assets/
!app/assets/*

# Exclusiones dentro de lo permitido (tienen prioridad por ir al final)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.streamlit/secrets.toml
.env
